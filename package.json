{
  "name": "zynergia",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.14 <23",
    "npm": ">=10.9 <11"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:native": "VITE_NATIVE_BUILD=true vite build --mode native",
    "build:demo": "VITE_DEMO_MODE=true vite build --mode demo",
    "build:review": "VITE_REVIEW_MODE=true vite build --mode review",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:demo": "ZYNERGIA_DEMO_E2E=true playwright test",
    "typecheck": "tsc -p ./jsconfig.json",
    "typecheck:backend": "tsc -p ./jsconfig.backend.json",
    "verify:native-bundle": "node scripts/verify-native-bundle.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.1.0",
    "@capacitor/app": "^8.0.1",
    "@capacitor/core": "^8.1.0",
    "@capacitor/ios": "^8.1.0",
    "@capacitor/local-notifications": "^8.0.1",
    "@capacitor/status-bar": "^8.0.1",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@supabase/supabase-js": "^2.98.0",
    "@tanstack/react-query": "^5.84.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "framer-motion": "^11.16.4",
    "lucide-react": "^0.475.0",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^2.15.4",
    "sonner": "^2.0.1",
    "stripe": "^22.1.1",
    "tailwind-merge": "^3.0.2",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.1.0",
    "@eslint/js": "^9.19.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.13.5",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "baseline-browser-mapping": "^2.8.32",
    "eslint": "^9.19.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^15.14.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vite": "^6.1.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "nanoid": "^3.3.18",
    "ws": "^8.21.0"
  }
}
