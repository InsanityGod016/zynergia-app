{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/stripe/webhook.js": { "maxDuration": 60 },
    "api/account/process-deletions.js": { "maxDuration": 60 },
    "api/notifications/process.js": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/account/process-deletions", "schedule": "0 6 * * *" }
  ],
  "redirects": [
    { "source": "/landing", "destination": "/", "permanent": true },
    { "source": "/register", "destination": "/crear-cuenta", "permanent": true },
    { "source": "/download", "destination": "/app", "permanent": true },
    { "source": "/privacy-policy.html", "destination": "/privacidad", "permanent": true },
    { "source": "/privacy.html", "destination": "/privacidad", "permanent": true },
    { "source": "/terms.html", "destination": "/terminos", "permanent": true },
    { "source": "/support.html", "destination": "/soporte", "permanent": true },
    { "source": "/delete-account.html", "destination": "/eliminar-cuenta", "permanent": true }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" }
      ]
    },
    {
      "source": "/.well-known/mobile-releases.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Cache-Control", "value": "no-store, max-age=0" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/connect-create", "destination": "/api/retired" },
    { "source": "/api/create-checkout", "destination": "/api/retired" },
    { "source": "/api/delete-account", "destination": "/api/retired" },
    { "source": "/api/finalize-account", "destination": "/api/retired" },
    { "source": "/api/verify-payment", "destination": "/api/retired" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
