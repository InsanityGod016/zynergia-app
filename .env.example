# Public client configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=https://zynergia.pro
VITE_PUBLIC_SITE_URL=https://zynergia.pro
VITE_SUPPORT_EMAIL=
VITE_APP_STORE_URL=https://apps.apple.com/mx/app/zynergia/id6761772857?l=en-GB
# Leave blank until the Android release is ready for customers.
VITE_PLAY_STORE_URL=
# Local simulator gallery only. Never configure this in hosting or store builds.
# VITE_DEMO_MODE=true
# Real app and real Supabase data, but no billing gate. Local Xcode review only.
# VITE_REVIEW_MODE=true

# Server-only configuration (never prefix these with VITE_)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
# Optional only for customers already entitled on the legacy annual plan.
STRIPE_ANNUAL_PRICE_ID=
STRIPE_LEGACY_PRICE_IDS=
# Midnight on 2026-09-01 in Mexico City. Only explicitly tagged subscriptions created after this instant use Connect.
STRIPE_CONNECT_EFFECTIVE_AT=2026-09-01T06:00:00.000Z
# One fixed connected account. Never expose this configuration through VITE_* variables.
STRIPE_PARTNER_ACCOUNT_ID=
STRIPE_PARTNER_EMAIL=
# Fail-closed verification for the reviewed CoreFlowAI US -> partner MX route.
STRIPE_PLATFORM_COUNTRY=US
STRIPE_PARTNER_COUNTRY=MX
# Keep false until migration 202608310001 is applied and the Connect ledger passes Stripe test-mode drills.
STRIPE_CONNECT_REVERSALS_READY=false
# At least 32 random characters; used only by POST /api/connect/onboarding-link.
CONNECT_ADMIN_SECRET=
APP_URL=https://zynergia.pro
CORS_ALLOWED_ORIGINS=
CRON_SECRET=
DELETE_REAUTH_MAX_AGE_SECONDS=600
BILLING_GRACE_DAYS=3
CHECKOUT_SUCCESS_PATH=/pago/exito
CHECKOUT_CANCEL_PATH=/cuenta
PORTAL_RETURN_PATH=/cuenta
# Optional Stripe Customer Portal configuration limited to payment-method updates.
STRIPE_PORTAL_CONFIGURATION_ID=
NEW_SIGNUPS_ENABLED=false
DELETION_CRON_CONFIGURED=false
# One-time legacy import. Enable only for the controlled POST, then disable it again.
LEGACY_RECONCILIATION_ENABLED=false
# At least 32 random characters. Never put it in a URL or a VITE_* variable.
LEGACY_RECONCILIATION_SECRET=
