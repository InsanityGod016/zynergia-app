    {
      "definition": "CREATE OR REPLACE FUNCTION public.get_partners_fs_metrics(user_ids uuid[], premier_product_ids text[])\n RETURNS TABLE(user_id uuid, premier_clients integer, partners_count integer)\n LANGUAGE sql\n SECURITY DEFINER\nAS $function$\r\n  WITH premier AS (\r\n    SELECT s.user_id, COUNT(DISTINCT s.contact_id)::INTEGER as premier_clients\r\n    FROM sales s\r\n    WHERE s.user_id = ANY(user_ids)\r\n      AND s.product_id = ANY(premier_product_ids)\r\n      AND (s.status IS NULL OR s.status <> 'cancelled')\r\n    GROUP BY s.user_id\r\n  ),\r\n  partcount AS (\r\n    SELECT p.user_id, COUNT(*)::INTEGER as partners_count\r\n    FROM partners p\r\n    WHERE p.user_id = ANY(user_ids)\r\n    GROUP BY p.user_id\r\n  )\r\n  SELECT \r\n    u.id as user_id,\r\n    COALESCE(pr.premier_clients, 0) as premier_clients,\r\n    COALESCE(pc.partners_count, 0) as partners_count\r\n  FROM unnest(user_ids) u(id)\r\n  LEFT JOIN premier pr ON pr.user_id = u.id\r\n  LEFT JOIN partcount pc ON pc.user_id = u.id;\r\n$function$\n",
      "identity_arguments": "user_ids uuid[], premier_product_ids text[]",
      "name": "get_partners_fs_metrics",
      "result": "TABLE(user_id uuid, premier_clients integer, partners_count integer)",
      "security_definer": true
    },
    {
      "definition": "CREATE OR REPLACE FUNCTION public.import_partner_clients(p_partner_user_id uuid)\n RETURNS integer\n LANGUAGE plpgsql\n SECURITY DEFINER\nAS $function$\r\nDECLARE\r\n  imported INTEGER := 0;\r\n  r RECORD;\r\n  caller_id UUID := auth.uid();\r\nBEGIN\r\n  FOR r IN \r\n    SELECT * FROM contacts \r\n    WHERE user_id = p_partner_user_id AND contact_type = 'cliente_producto'\r\n  LOOP\r\n    INSERT INTO contacts (user_id, full_name, phone, country_code, notes, contact_type, tag_ids)\r\n    VALUES (caller_id, r.full_name, r.phone, r.country_code, r.notes, 'cliente_producto', r.tag_ids);\r\n    imported := imported + 1;\r\n  END LOOP;\r\n  RETURN imported;\r\nEND;\r\n$function$\n",
      "identity_arguments": "p_partner_user_id uuid",
      "name": "import_partner_clients",
      "result": "integer",
