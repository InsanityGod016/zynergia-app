    {
      "definition": "CREATE OR REPLACE FUNCTION public.register_as_partner(p_upline_user_id uuid, p_new_user_name text, p_new_user_id uuid)\n RETURNS void\n LANGUAGE plpgsql\n SECURITY DEFINER\nAS $function$\r\nDECLARE\r\n  v_contact_id UUID;\r\n  v_today TEXT := to_char(NOW(), 'YYYY-MM-DD');\r\n  v_deadline TEXT := to_char(NOW() + INTERVAL '120 days', 'YYYY-MM-DD');\r\nBEGIN\r\n  -- Create contact in upline's account\r\n  INSERT INTO contacts (user_id, full_name, contact_type, phone, country_code, notes)\r\n  VALUES (p_upline_user_id, p_new_user_name, 'partner', '', '+52', 'Agregado por código de invitación')\r\n  RETURNING id INTO v_contact_id;\r\n\r\n  -- Create partner record\r\n  INSERT INTO partners (user_id, contact_id, partner_user_id, start_date, fast_start_deadline,\r\n    fast_start_status, fase_actual, qteam_completed, fs_level1_completed, fs_level2_completed, xteam_completed)\r\n  VALUES (p_upline_user_id, v_contact_id, p_new_user_id, v_today, v_deadline,\r\n    'activo', 1, false, false, false, false);\r\nEND;\r\n$function$\n",
      "identity_arguments": "p_upline_user_id uuid, p_new_user_name text, p_new_user_id uuid",
