  "functions": [
    {
      "definition": "CREATE OR REPLACE FUNCTION public.get_partner_partners_count(p_user_id uuid)\n RETURNS integer\n LANGUAGE sql\n SECURITY DEFINER\nAS $function$\r\n  SELECT COUNT(*)::INTEGER FROM partners WHERE user_id = p_user_id;\r\n$function$\n",
      "identity_arguments": "p_user_id uuid",
      "name": "get_partner_partners_count",
      "result": "integer",
      "security_definer": true
    },
    {
      "definition": "CREATE OR REPLACE FUNCTION public.get_partner_sales_data(p_user_id uuid)\n RETURNS TABLE(product_id text, contact_id uuid, status text)\n LANGUAGE sql\n SECURITY DEFINER\nAS $function$\r\n  SELECT \r\n    product_id,\r\n    contact_id,\r\n    COALESCE(status, 'active') as status\r\n  FROM sales\r\n  WHERE user_id = p_user_id;\r\n$function$\n",
      "identity_arguments": "p_user_id uuid",
      "name": "get_partner_sales_data",
      "result": "TABLE(product_id text, contact_id uuid, status text)",
      "security_definer": true
    },
    {
      "definition": "CREATE OR REPLACE FUNCTION public.get_partner_stats(p_user_id uuid)\n RETURNS json\n LANGUAGE plpgsql\n SECURITY DEFINER\nAS $function$\r\nDECLARE result JSON;\r\nBEGIN\r\n  SELECT json_build_object(\r\n    'clients', (SELECT COUNT(*) FROM contacts WHERE user_id = p_user_id AND contact_type = 'cliente_producto'),\r\n    'active_sales', (SELECT COUNT(*) FROM sales WHERE user_id = p_user_id AND status = 'active'),\r\n    'partners', (SELECT COUNT(*) FROM partners WHERE user_id = p_user_id),\r\n    'active_partners', (SELECT COUNT(*) FROM partners WHERE user_id = p_user_id AND fast_start_status = 'activo'),\r\n    'tasks_done', (SELECT COUNT(*) FROM tasks WHERE user_id = p_user_id AND status = 'completed')\r\n  ) INTO result;\r\n  RETURN result;\r\nEND;\r\n$function$\n",
      "identity_arguments": "p_user_id uuid",
      "name": "get_partner_stats",
      "result": "json",
      "security_definer": true
    },
    {
